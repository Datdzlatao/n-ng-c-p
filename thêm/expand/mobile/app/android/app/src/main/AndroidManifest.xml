<!-- Android Manifest for Smart Attendance App -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions ─────────────────────────────────────────────────── -->
    
    <!-- Camera: cho QR scan và nhận diện khuôn mặt -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" />
    
    <!-- Internet: Firebase, sync dữ liệu -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Kiểm tra trạng thái mạng -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Đọc/ghi storage (Android < 13): lưu ảnh vi phạm -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    
    <!-- Android 13+: quyền ảnh cụ thể -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    
    <!-- Vibration: feedback khi điểm danh thành công -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Điểm Danh STEM"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
            <!-- Deep link: diemdanh://app/... -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        
        <!-- Flutter Provider meta-data -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
            
        <!-- ML Kit Face Detection: không cần bundle model (dùng Play Services) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face" />
    </application>
    
    <!-- Truy vấn network cho certificate pinning -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
    </queries>
</manifest>

# Multi-Tenant STEM Attendance Platform — Environment Configuration
# Copy this file to .env and customize values for your deployment:
#   cp .env.example .env

# ── Application Environment ──
DEBUG=false

# ── Security & Authentication ──
# Generate a secure 32+ byte random hex string: openssl rand -hex 32
JWT_SECRET=generate_with_openssl_rand_hex_32
JWT_EXPIRE_HOURS=1
JWT_REFRESH_EXPIRE_DAYS=14

# ── CORS Settings ──
# In production, specify exact trusted domains: e.g. https://stemapp.vn,https://admin.stemapp.vn
CORS_ORIGINS=https://stemapp.vn

# ── Database (Hybrid SQLite / PostgreSQL) ──
# Empty means SQLite default (backend/data/stem_platform.db)
# For production multi-tenant concurrency, configure PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://stem_user:strong_password@localhost:5432/stem_db
DATABASE_URL=

# ── Cache & Rate Limiting ──
# Optional Redis connection URL for distributed rate limiting
REDIS_URL=

# ── Platform Master Admin Seed ──
# Only used for initial setup/seeding. Passwords in database are hashed with PBKDF2.
PLATFORM_ADMIN_EMAIL=admin@stemapp.vn
PLATFORM_ADMIN_PASSWORD=SetAStrongMasterAdminPassword2026!

# ── Google Gemini AI ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Notifications ──
ZALO_OA_TOKEN=
FCM_SERVER_KEY=

# ── OTP Verification ──
# Set to false in production to prevent returning dev_otp in API response
OTP_DEV_MODE=false
